{
  "author": "Frank",
  "id": "com.frank.weather",
  "name": "Weather",
  "description": "Current conditions, the next hours and the week ahead, from Open-Meteo (no account needed). Set your town in the widget's settings.",
  "version": "1.0.0",
  "preview_icon": "resources/icon.png",
  "min_app_version": "5.44",
  "min_framework_version": "1.0.0",
  "os": [
    {
      "platform": "windows"
    }
  ],
  "supported_devices": [
    {
      "type": "dashboard_lcd"
    }
  ],
  "interactive": true,
  "permissions": [
    {
      "type": "url",
      "domain": "api.open-meteo.com"
    },
    {
      "type": "url",
      "domain": "geocoding-api.open-meteo.com"
    }
  ]
}
