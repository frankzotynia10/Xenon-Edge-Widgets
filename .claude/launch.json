{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "apple-music-widget",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const r=p.resolve('apple-music-edge/widget');h.createServer((q,s)=>{const fp=p.join(r,decodeURIComponent(q.url.split('?')[0])==='/'?'index.html':decodeURIComponent(q.url.split('?')[0]));if(!fp.startsWith(r))return s.end();f.readFile(fp,(e,d)=>{if(e){s.writeHead(404);return s.end()}s.writeHead(200,{'content-type':fp.endsWith('.html')?'text/html':fp.endsWith('.png')?'image/png':'application/octet-stream'});s.end(d)})}).listen(5177,'127.0.0.1')"
      ],
      "port": 5177
    },
